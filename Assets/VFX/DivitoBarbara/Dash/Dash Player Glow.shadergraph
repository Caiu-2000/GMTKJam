{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "911f0aee080440f2b6bbdec06979f5b0",
    "m_Title": "Outline",
    "m_Content": "Mueve el alpha en cuatro direcciones para generar el outline, luego se juntan con Add. Después se usa substract con el alpha de la textura original y el nuevo alpha movido y genera el outline. Al usar Add la opacidad supero 1, se usa un clamp para restringir los valores y funcione el Substract.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -3940.800048828125,
        "y": -238.40000915527345,
        "width": 200.0,
        "height": 181.60000610351563
    },
    "m_Group": {
        "m_Id": ""
    }
}

